# ============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA UNIFORMA (EQUIPO 16 - U3-E1)
# Copie este archivo como ".env" en la raíz del proyecto.
# ============================================================================

APP_NAME="Sistema Uniforma"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT="8000"
APP_VERSION="1.2.0-E1"

# ----------------------------------------------------------------------------
# MOTOR DE BASE DE DATOS:
# Use "postgresql" para conectar con su servidor PostgreSQL local (pgAdmin 4).
# (Si en algún equipo de prueba no hay PostgreSQL, puede cambiar a "sqlite3").
# ----------------------------------------------------------------------------
DB_ENGINE="postgresql"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="uniformadb"
DB_USER="postgres"
DB_PASSWORD="TU_PASSWORD_DE_POSTGRES"

# Ruta de respaldo en caso de usar DB_ENGINE="sqlite3"
DB_PATH="database/uniforma.db"

# Usuario activo por defecto (101 = Carlos Méndez [Vendedor] | 201 = Laura Torres [Gerente])
DEFAULT_USER_ID="101"
